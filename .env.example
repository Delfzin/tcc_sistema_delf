# Copie este arquivo para ".env" e preencha com os seus valores.
# No PowerShell:  Copy-Item .env.example .env
#
# O arquivo ".env" guarda senhas. Ele NUNCA vai para o GitHub (o .gitignore já impede).
# Este repositório é público: nunca escreva senha de verdade em ".env.example".

# Ambiente: desenvolvimento, teste ou producao.
# Com "producao", o comando de dados de teste (npm run semear) se recusa a rodar.
DELF_AMBIENTE=desenvolvimento

# Banco de dados usado pela API. Formato:
#   postgres://USUARIO:SENHA@ENDERECO:PORTA/NOME_DO_BANCO
DATABASE_URL=postgres://usuario:senha@127.0.0.1:5432/delf

# Criptografia da conexão com o banco:
#   auto           desligada no seu computador, ligada e verificada em qualquer outro endereço
#   ligado         criptografa e confere o certificado do servidor (recomendado na nuvem)
#   sem-verificar  criptografa mas não confere quem está do outro lado (mais fraco)
#   desligado      sem criptografia (somente para o seu computador)
DATABASE_SSL=auto
# Caminho de um arquivo de certificado (opcional), se o provedor do banco exigir.
DATABASE_SSL_CA=

# Endereço com permissão de criar tabelas. Usado só por "npm run migrar" e "npm run semear".
# Se ficar vazio, usa DATABASE_URL.
DATABASE_URL_MIGRACAO=

# Usado só por "npm test". Precisa ser um PostgreSQL do SEU computador, com um usuário
# que possa criar bancos. Os testes criam e apagam o banco "delf_teste".
# Aponte para o banco "postgres": os testes trocam o nome sozinhos.
DATABASE_URL_TESTE=postgres://postgres:senha@127.0.0.1:5432/postgres
